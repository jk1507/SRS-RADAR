# Requirement Radar Environment Configuration

# Run Profile: local-free | cloud-free
PROFILE=local-free

# Database Configuration
POSTGRES_USER=srs_user
POSTGRES_PASSWORD=srs_password
POSTGRES_DB=srs_radar
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://srs_user:srs_password@postgres:5432/srs_radar

# Redis (Pub/Sub & Cache)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Storage Backend (MinIO / S3)
STORAGE_BACKEND=local
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_password
MINIO_BUCKET=srs-documents

# LLM Provider Configuration
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
MODEL_FAST=qwen2.5:7b-instruct
MODEL_REASONING=qwen2.5:7b-instruct

# Embedding Configuration
EMBEDDING_PROVIDER=local
MODEL_EMBEDDING=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# LLM Rate Limiting & Budgets
LLM_RPM=60
LLM_TPM=100000
LLM_MAX_CONCURRENCY=4
RUN_TOKEN_BUDGET=500000

# Security
JWT_SECRET=change-this-super-secret-jwt-key-in-production-32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
